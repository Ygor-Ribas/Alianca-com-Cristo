# Copie este arquivo para ".env" e preencha com valores reais.
# NUNCA suba o arquivo ".env" para o GitHub (adicione-o ao .gitignore).

DB_HOST=localhost
DB_USER=root
DB_PASSWORD=troque_esta_senha_por_uma_forte
DB_NAME=alianca_com_cristo
PORT=3000

# Gere um valor novo e aleatório, por exemplo com:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=troque_este_valor_por_um_aleatorio_e_secreto

# "production" em servidor real com HTTPS (ativa cookie seguro)
NODE_ENV=production
